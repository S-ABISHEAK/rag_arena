GROQ_API_KEY=

QDRANT_HOST=localhost
QDRANT_PORT=6333

REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated list of allowed frontend origins in production, e.g.
# https://myapp.com,https://www.myapp.com — defaults to local dev ports
# if unset.
CORS_ORIGINS=

MAX_UPLOAD_SIZE_MB=25

# Required in production — leave empty locally. When set, every /index,
# /query, /evaluate, and /router route requires a matching X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend must be built with the same value in VITE_API_KEY
# (frontend/.env) — set that in your hosting platform's build env, never
# committed, since Vite bakes it into the public JS bundle either way.
API_KEY=
